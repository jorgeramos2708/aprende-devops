# ============================================================================
# REFERENCIA VERSIONADA del Caddyfile vivo en el VPS (~/caddy/Caddyfile).
# Caddy corre en su propio contenedor (fuera de este repo/compose).
# Al cambiar este archivo hay que aplicarlo manualmente en el VPS:
#   docker exec caddy caddy fmt --overwrite /etc/caddy/Caddyfile
#   docker exec caddy caddy reload --config /etc/caddy/Caddyfile
#
# Reglas:
#  - Hostnames en nube NARANJA (Cloudflare proxied): import cf_only + sec_headers
#  - registry.edrs.xyz es GRIS (DNS only) por el limite de ~100MB de subida de CF:
#    jamas import cf_only ahi.
# ============================================================================

{
	servers {
		# IP real del visitante cuando el peer inmediato es Cloudflare (naranja).
		# Los clientes directos (gris) no pueden falsear X-Forwarded-For.
		# OJO: con esto activo, `client_ip` = IP del VISITANTE; para filtrar el
		# peer de la conexion (si llego via CF o directo) usar `remote_ip`.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

(cf_only) {
	# Rechaza en el origen quien intente bypasear Cloudflare.
	# remote_ip = peer TCP directo (NO se ve afectado por trusted_proxies).
	@not_cf not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	respond @not_cf 403
}

(sec_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

aprende-devops.edrs.xyz {
	import cf_only
	import sec_headers
	encode zstd gzip

	log {
		output file /var/log/caddy/aprende-devops.access.log
		format json # guarda client_ip real (fail2ban lo lee para banear en el edge CF)
	}

	handle /api/* {
		reverse_proxy api:8080
	}
	handle /hubs/* {
		reverse_proxy api:8080 # WebSocket SignalR del terminal de labs
	}
	handle /health {
		reverse_proxy api:8080
	}
	handle {
		reverse_proxy web:80
	}
}

registry.edrs.xyz {
	# GRIS: acceso directo de docker/CI. Protegido por auth htpasswd de Zot
	# + fail2ban (caddy-registry-auth) baneando en iptables local.
	reverse_proxy zot:5000 {
		flush_interval -1
	}
	request_body {
		max_size 5g
	}
}

passvault.edrs.xyz {
	import cf_only
	import sec_headers
	reverse_proxy vaultwarden:80
}

monitor.edrs.xyz {
	import cf_only
	import sec_headers
	reverse_proxy uptime-kuma:3001
}
