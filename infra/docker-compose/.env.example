# ============================================================================
# Variables de entorno - Aprende DevOps (produccion)
# Copiar a infra/docker-compose/.env en el VPS (/opt/aprende-devops) y rellenar.
# NUNCA commitear el .env real. Generar secretos: openssl rand -base64 48
# ============================================================================

# --- PostgreSQL ---
POSTGRES_PASSWORD=

# --- JWT (minimo 32 caracteres) ---
JWT_KEY=

# --- MinIO ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Grafana (perfil obs) ---
GF_ADMIN_PASSWORD=

# --- Backups a Cloudflare R2 (contenedor backup) ---
R2_ACCOUNT_ID=          # Account ID de Cloudflare (dashboard R2)
R2_BUCKET=              # bucket R2 creado para backups, ej. aprende-devops-backups
AWS_ACCESS_KEY_ID=      # API token R2 con permisos Object Read/Write
AWS_SECRET_ACCESS_KEY=
RESTIC_PASSWORD=        # passphrase de cifrado del repo restic (guardarla bien!)
